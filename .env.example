# --- Application ---
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Demo mode (round 1 local-only; OIDC planned) ---
# When DEMO_MODE=true the API accepts all requests without auth.
# R2: demo mode MUST be false in production.
DEMO_MODE=true

# --- Database ---
DATABASE_URL=sqlite:///./lumen.db

# --- Keycloak OIDC (planned for round 2) ---
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
OIDC_AUDIENCE=

# --- Keycloak admin password (Docker compose) ---
KEYCLOAK_ADMIN_PASSWORD=

# --- Client secret for realm import (env var interpolation in keycloak-realm.json) ---
LUMEN_CLIENT_SECRET=

# --- LLM adapter (opt-in; R1 returns advisory-unavailable) ---
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=